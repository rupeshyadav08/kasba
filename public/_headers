# Cloudflare Pages headers. Astro's /_astro/ files have a hash in their name, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The plain-text copies of stories are for AI assistants; search results should show the real page.
/story/*.md
  X-Robots-Tag: noindex
/en/story/*.md
  X-Robots-Tag: noindex

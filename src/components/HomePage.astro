---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
import SectionBlock from './SectionBlock.astro';
import LocalHeadlines from './LocalHeadlines.astro';
import { upcomingDeadlines } from '../lib/deadlines';
import { examPath } from '../lib/exams';
import { categories, dateFmt, secColor, sectionOrder, storyPath, t, type Lang } from '../lib/i18n';
import { org } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const stories = (await getCollection('stories', ({ data }) => data.lang === lang))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const [lead, ...after] = stories;
const trio = after.slice(0, 3);
const latest = after.slice(3, 9);
// A section does not repeat the stories already shown large at the top, unless that would leave it thin.
const top = new Set([lead, ...trio].filter(Boolean).map((s) => s.data.storyId));
const inSection = (sec: string) => {
  const all = stories.filter((s) => s.data.category === sec);
  const fresh = all.filter((s) => !top.has(s.data.storyId));
  return fresh.length >= 3 ? fresh : all;
};
// Always-updated guide pages, linked from the home page so readers and search engines find them.
const guides = (await getCollection('exams', ({ data }) => data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const chip = (name: string) => name.split(/[:(]/)[0].trim();
const timeFmt = new Intl.DateTimeFormat(lang === 'hi' ? 'hi-IN' : 'en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
const L = t[lang];
const deadlines = (await upcomingDeadlines(lang)).slice(0, 4);
const p = lang === 'hi' ? '' : '/en';
const home = new URL(lang === 'hi' ? '/' : '/en', Astro.site).toString();
const title = lang === 'hi' ? 'कस्बा (Kasba): सरकारी योजना, नौकरी, परीक्षा और किसान की ख़बरें आसान हिंदी में' : 'Kasba: government schemes, jobs, exams and farming news in plain language';
const jsonLd = [
  { '@context': 'https://schema.org', ...org },
  {
    '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${home}#site`,
    name: lang === 'hi' ? 'कस्बा' : 'Kasba', alternateName: lang === 'hi' ? 'Kasba' : 'कस्बा',
    url: home, inLanguage: lang, description: L.tagline, publisher: { '@id': org['@id'] },
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: L.topStories,
    itemListElement: stories.slice(0, 10).map((s, i) => ({
      '@type': 'ListItem', position: i + 1, url: new URL(storyPath(lang, s.data.storyId), Astro.site).toString(),
    })),
  },
];
---
<Base lang={lang} title={title} description={L.homeDescription} altPath={lang === 'hi' ? '/en' : '/'} jsonLd={jsonLd}>
  <main class="home">
    <h1 class="visually-hidden">{title}</h1>
    <section class="top" aria-label={L.topStories}>
      <div class="lead">{lead && <StoryCard story={lead} size="hero" eager />}</div>
      {latest.length > 0 && (
        <aside class="latest" aria-labelledby="latest-h">
          <h2 id="latest-h" class="serif"><span class="dot" aria-hidden="true"></span>{L.latestNews}</h2>
          <ol>
            {latest.map((s) => (
              <li style={secColor(s.data.category)}>
                <a href={storyPath(lang, s.data.storyId)}>
                  <span class="l-meta"><span class="kicker">{categories[s.data.category][lang]}</span><time datetime={s.data.published.toISOString()} data-ago>{timeFmt.format(s.data.published)}</time></span>
                  <span class="l-title">{s.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </section>

    {trio.length > 0 && (
      <section class="trio" aria-label={L.topStories}>
        {trio.map((s) => <StoryCard story={s} size="tall" />)}
      </section>
    )}

    {deadlines.length > 0 && (
      <section class="dates" aria-labelledby="dl-h">
        <header>
          <div><h2 id="dl-h" class="serif">{L.deadlines}</h2><p>{lang === 'hi' ? 'फ़ॉर्म, फ़ीस और परीक्षा की तारीख़ें: कहीं छूट न जाए' : 'Forms, fees and exam dates you should not miss'}</p></div>
          <a class="pill" href={`${p}/deadlines`}>{L.allDeadlines} →</a>
        </header>
        <div class="tiles">
          {deadlines.map(({ story, days }) => (
            <a class={days <= 3 ? 'tile soon' : 'tile'} href={storyPath(lang, story.data.storyId)}>
              <span class="left">{days === 0 ? L.today : L.daysLeft(days)}</span>
              <span class="what">{story.data.title}</span>
              <span class="when">{dateFmt(lang, story.data.deadline!.date)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="guides" aria-labelledby="guides-h">
      <header>
        <h2 id="guides-h" class="serif">{lang === 'hi' ? 'परीक्षा और योजना गाइड' : 'Exam and scheme guides'}</h2>
        <a class="pill" href={examPath(lang)}>{lang === 'hi' ? 'सभी गाइड' : 'All guides'} →</a>
      </header>
      <ul>{guides.map((g) => <li><a href={examPath(lang, g.data.examId)}>{chip(g.data.name)}</a></li>)}</ul>
    </nav>

    <LocalHeadlines lang={lang} limit={4} />

    {sectionOrder.filter((sec) => stories.some((s) => s.data.category === sec)).map((sec) => (
      <SectionBlock lang={lang} section={sec} stories={inSection(sec)} />
    ))}
  </main>
</Base>
<style>
  .home { display: flex; flex-direction: column; gap: 2rem; padding: var(--gap) var(--gap) 0; }
  @media (min-width: 740px) { .home { padding: 1rem 1.6rem 0; gap: 2.5rem; } }

  .top { display: grid; gap: var(--gap); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) { .top { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); } }
  .lead { display: flex; flex-direction: column; min-width: 0; }
  .lead > :global(*) { flex: 1; }

  .latest { background: var(--card); border-radius: var(--r-card); padding: 1.1rem 1.1rem 0.5rem; }
  @media (min-width: 740px) { .latest { padding: 1.3rem 1.4rem 0.6rem; } }
  .latest h2 { margin: 0 0 0.3rem; font-size: 1.6rem; line-height: 1.2; display: flex; align-items: center; gap: 0.55rem; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--hl-red); }
  .latest ol { list-style: none; margin: 0; padding: 0; }
  .latest li + li { border-top: 1px solid var(--line); }
  .latest a { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.7rem 0; }
  .l-meta { display: flex; gap: 0.7rem; align-items: baseline; font-family: var(--sans); font-size: 0.82rem; color: var(--muted); }
  .l-title { font-family: var(--display); font-size: 1.08rem; line-height: 1.38; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .latest a:hover .l-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }

  .trio { display: grid; gap: var(--gap); grid-template-columns: minmax(0, 1fr); margin-top: calc(var(--gap) - 2rem); }
  @media (min-width: 740px) { .trio { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: calc(var(--gap) - 2.5rem); } }

  .dates { background: var(--cream); border-radius: var(--r-card); padding: 1.1rem; display: grid; gap: 0.9rem; }
  @media (min-width: 740px) { .dates { padding: 1.4rem 1.5rem 1.5rem; } }
  .dates header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .dates h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.1rem); line-height: 1.15; }
  .dates p { margin: 0.15rem 0 0; color: var(--text-soft); font-size: 0.97rem; }
  .dates .pill { font-size: 0.95rem; white-space: nowrap; }
  .tiles { display: grid; gap: var(--gap); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .tile { display: flex; flex-direction: column; gap: 0.4rem; background: var(--bg); border-radius: var(--r-tile); padding: 0.9rem 1rem 1rem; }
  /* An odd last tile fills the row instead of leaving a hole. */
  @media (max-width: 899px) { .tile:last-child:nth-child(odd) { grid-column: span 2; } }
  .left { align-self: flex-start; font-family: var(--sans); font-weight: 600; font-size: 0.85rem; padding: 0.1rem 0.6rem; border-radius: 999px; background: var(--up-tint); color: var(--up); }
  .soon .left { background: var(--down-tint); color: var(--down); }
  .what { font-family: var(--display); font-size: 1.02rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .when { margin-top: auto; font-family: var(--sans); font-size: 0.82rem; color: var(--muted); }
  .tile:hover .what { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }

  .guides { display: grid; gap: 0.8rem; }
  .guides header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; padding: 0 0.25rem; }
  .guides h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.1rem); line-height: 1.15; }
  .guides .pill { font-size: 0.95rem; white-space: nowrap; }
  .guides ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .guides li a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border-radius: 999px; background: var(--card); font-family: var(--sans); font-size: 0.98rem; }
  .guides li a:hover { background: var(--text); color: var(--bg); }
  /* On a phone the chips scroll sideways in two rows instead of filling the screen. */
  @media (max-width: 739px) {
    .guides ul { display: grid; grid-auto-flow: column; grid-template-rows: repeat(3, auto); justify-content: start; overflow-x: auto; scrollbar-width: none; margin: 0 calc(-1 * var(--gap)); padding: 0 var(--gap); }
    .guides li a { white-space: nowrap; }
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
import SectionBlock from './SectionBlock.astro';
import LocalStrip from './LocalStrip.astro';
import LocalHeadlines from './LocalHeadlines.astro';
import { upcomingDeadlines } from '../lib/deadlines';
import { districts } from '../lib/places';
import { categories, dateFmt, sectionOrder, storyPath, t, type Lang } from '../lib/i18n';
import { org } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const stories = (await getCollection('stories', ({ data }) => data.lang === lang))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const [lead, second, third, ...more] = stories;
const L = t[lang];
const deadlines = (await upcomingDeadlines(lang)).slice(0, 4);
const p = lang === 'hi' ? '' : '/en';
const home = new URL(lang === 'hi' ? '/' : '/en', Astro.site).toString();
// Follow/share tiles: Kasba has no social accounts yet, so these share the site instead.
const shareUrl = encodeURIComponent(home);
const shareText = encodeURIComponent(lang === 'hi' ? 'कस्बा: छोटे शहरों की बड़ी ख़बरें' : 'Kasba: big news for small towns');
const tiles = [
  { name: 'WhatsApp', href: `https://wa.me/?text=${shareText}%20${shareUrl}`, color: '#1a7f4b', tint: 'rgb(37 211 102 / 0.1)',
    d: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z' },
  { name: 'Telegram', href: `https://t.me/share/url?url=${shareUrl}&text=${shareText}`, color: '#229ed9', tint: 'rgb(42 171 238 / 0.1)',
    d: 'M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.8-3.6-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2l-11 6.9-4.7-1.5c-1-.3-1-1 .2-1.5L20.6 3c.9-.3 1.6.2 1.3 1.3Z' },
  { name: 'X', href: `https://x.com/intent/post?url=${shareUrl}&text=${shareText}`, color: 'var(--text)', tint: 'rgb(127 127 127 / 0.1)',
    d: 'M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L2 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z' },
  { name: 'RSS', href: lang === 'hi' ? '/rss.xml' : '/en/rss.xml', color: '#c4570f', tint: 'rgb(238 128 43 / 0.12)',
    d: 'M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3Zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7V9Zm2 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z' },
];
const jsonLd = [
  { '@context': 'https://schema.org', ...org },
  {
    '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${home}#site`,
    name: lang === 'hi' ? 'कस्बा' : 'Kasba', alternateName: lang === 'hi' ? 'Kasba' : 'कस्बा',
    url: home, inLanguage: lang, description: L.tagline, publisher: { '@id': org['@id'] },
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: L.topStories,
    itemListElement: stories.slice(0, 10).map((s, i) => ({
      '@type': 'ListItem', position: i + 1, url: new URL(storyPath(lang, s.data.storyId), Astro.site).toString(),
    })),
  },
];
---
<Base lang={lang} title={lang === 'hi' ? 'कस्बा: छोटे शहरों की बड़ी ख़बरें' : 'Kasba: big news for small towns'}
  description={L.tagline} altPath={lang === 'hi' ? '/en' : '/'} jsonLd={jsonLd}>
  <main class="home">
    <h1 class="visually-hidden">{lang === 'hi' ? 'कस्बा: छोटे शहरों की बड़ी ख़बरें' : 'Kasba: big news for small towns'}</h1>
    <section class="bento" aria-label={L.topStories}>
      <div class="col a">
        {lead && <StoryCard story={lead} size="hero" />}
      </div>

      <div class="col b">
        {second && <StoryCard story={second} size="tall" />}
        <a class="briefing" href={`${p}/briefing`}>
          <span class="serif b-title">{L.briefing}</span>
          <span class="b-text">{lang === 'hi' ? 'आज की ज़रूरी सरकारी सूचनाएँ, आसान भाषा में, कुछ मिनट में।' : "Today's essential official updates, in plain language, in a few minutes."}</span>
          <span class="b-stats">
            <span>▤ {stories.length} {lang === 'hi' ? 'ख़बरें' : 'stories'}</span>
            <span>⌖ {districts.length} {lang === 'hi' ? 'ज़िले' : 'districts'}</span>
          </span>
        </a>
        <ul class="tiles" aria-label={lang === 'hi' ? 'कस्बा को आगे भेजें' : 'Share Kasba'}>
          {tiles.map((x) => (
            <li><a href={x.href} rel="noopener" target={x.name === 'RSS' ? undefined : '_blank'} style={`--tile: ${x.tint}; --ico: ${x.color}`} aria-label={x.name}>
              <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={x.d} /></svg>
            </a></li>
          ))}
        </ul>
        <LocalStrip lang={lang} />
      </div>

      <div class="col c">
        {third && <StoryCard story={third} size="tall" highlight="beige" />}
        {deadlines.length > 0 && (
          <section class="stats" aria-labelledby="dl-h">
            <h2 id="dl-h" class="visually-hidden">{L.deadlines}</h2>
            {deadlines.map(({ story, days }) => (
              <a class={days <= 7 ? 'stat down' : 'stat up'} href={storyPath(lang, story.data.storyId)}>
                <span class="s-top">
                  <svg class="spark" width="44" height="16" viewBox="0 0 44 16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.3" d="M1 12 7 9l5 3 6-7 6 4 5-5 6 3 7-6"/></svg>
                  <span class="badge" aria-hidden="true">{days <= 7 ? '!' : '↗'}</span>
                </span>
                <span class="serif s-num">{days === 0 ? L.today : days}<small>{days === 0 ? '' : lang === 'hi' ? ' दिन' : ' days'}</small></span>
                <span class="s-label">{story.data.deadline!.label}</span>
                <span class="s-date">{dateFmt(lang, story.data.deadline!.date)}</span>
              </a>
            ))}
          </section>
        )}
        {deadlines.length < 2 && more.length > 0 && (
          <div class="more">{more.slice(0, 2).map((s) => <StoryCard story={s} size="compact" />)}</div>
        )}
        <a class="cta" href={`${p}/deadlines`}>
          <span><span class="serif cta-title">{L.deadlines}</span><span class="cta-sub">{lang === 'hi' ? 'फ़ॉर्म, फ़ीस और परीक्षा की तारीख़ें' : 'Forms, fees and exam dates'}</span></span>
          <span class="round" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <LocalHeadlines lang={lang} limit={4} />

    {sectionOrder.filter((sec) => stories.some((s) => s.data.category === sec)).map((sec) => (
      <SectionBlock lang={lang} section={sec} stories={stories.filter((s) => s.data.category === sec)} />
    ))}
  </main>
</Base>
<style>
  .home { display: flex; flex-direction: column; gap: 2.5rem; padding: var(--gap) var(--gap) 0; }
  @media (min-width: 740px) { .home { padding: 1rem 1.6rem 0; } }
  .bento { display: grid; gap: var(--gap); grid-template-columns: minmax(0, 1fr); }
  .col { display: flex; flex-direction: column; gap: var(--gap); min-width: 0; }
  @media (min-width: 740px) { .bento { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .a { grid-column: 1 / -1; } }
  @media (min-width: 1150px) { .bento { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr); } .a { grid-column: auto; } }

  .briefing { display: flex; flex-direction: column; gap: 0.6rem; background: var(--cream); border-radius: var(--r-card); padding: 1.5rem; }
  .b-title { font-size: 1.75rem; line-height: 1.15; }
  .b-text { font-size: 1.02rem; line-height: 1.5; }
  .b-stats { display: flex; gap: 1.25rem; color: var(--text-soft); font-size: 0.95rem; }
  .briefing:hover .b-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }

  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .tiles a { display: grid; place-items: center; aspect-ratio: 1; border-radius: var(--r-tile); background: var(--tile); color: var(--ico); min-height: 64px; }
  .tiles a:hover { filter: brightness(0.96); }

  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; padding: 1rem 1.1rem 1.1rem; border-radius: 20px; min-height: 11rem; }
  /* An odd last card fills the row instead of leaving a hole. */
  .stat:last-of-type:nth-of-type(odd) { grid-column: span 2; min-height: 8rem; }
  .stat.up { background: var(--up-tint); }
  .stat.down { background: var(--down-tint); }
  .s-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: auto; }
  .spark { color: var(--text); }
  .badge { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-size: 0.9rem; color: #fff; }
  .up .badge { background: var(--up); }
  .down .badge { background: var(--down); }
  .s-num { font-size: 2.3rem; line-height: 1.05; margin-top: 0.75rem; }
  .s-num small { font-size: 0.95rem; color: var(--muted); font-family: var(--serif); }
  .s-label { font-size: 0.95rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .s-date { font-size: 0.8rem; color: var(--muted); }
  .stat:hover .s-label { text-decoration: underline; }

  .more { display: flex; flex-direction: column; gap: var(--gap); }
  .cta { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 0.5rem 0.5rem; }
  .cta > span:first-child { display: flex; flex-direction: column; }
  .cta-title { font-size: 1.5rem; line-height: 1.2; }
  .cta-sub { color: var(--muted); font-size: 0.95rem; }
  .round { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; background: var(--dark); color: #fff; display: grid; place-items: center; }
  .cta:hover .round { transform: rotate(45deg); transition: transform 0.2s; }
</style>

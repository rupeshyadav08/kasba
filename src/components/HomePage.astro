---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
import SectionBlock from './SectionBlock.astro';
import LocalStrip from './LocalStrip.astro';
import DeadlineList from './DeadlineList.astro';
import { upcomingDeadlines } from '../lib/deadlines';
import { sectionOrder, storyPath, t, type Lang } from '../lib/i18n';
import { org } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const stories = (await getCollection('stories', ({ data }) => data.lang === lang))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const [lead, ...top] = stories;
const secondary = top.slice(0, 4);
const L = t[lang];
const deadlines = (await upcomingDeadlines(lang)).slice(0, 3);
const p = lang === 'hi' ? '' : '/en';
const home = new URL(lang === 'hi' ? '/' : '/en', Astro.site).toString();
const jsonLd = [
  { '@context': 'https://schema.org', ...org },
  {
    '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${home}#site`,
    name: lang === 'hi' ? 'कस्बा' : 'Kasba', alternateName: lang === 'hi' ? 'Kasba' : 'कस्बा',
    url: home, inLanguage: lang, description: L.tagline, publisher: { '@id': org['@id'] },
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: L.topStories,
    itemListElement: stories.slice(0, 10).map((s, i) => ({
      '@type': 'ListItem', position: i + 1, url: new URL(storyPath(lang, s.data.storyId), Astro.site).toString(),
    })),
  },
];
---
<Base lang={lang} title={lang === 'hi' ? 'कस्बा: छोटे शहरों की बड़ी ख़बरें' : 'Kasba: big news for small towns'}
  description={L.tagline} altPath={lang === 'hi' ? '/en' : '/'} jsonLd={jsonLd}>
  <main class="page home">
    {lead && (
      <section class="top" aria-label={L.topStories}>
        <div class="lead"><StoryCard story={lead} size="lead" /></div>
        <div class="secondary">{secondary.map((s) => <StoryCard story={s} size="compact" />)}</div>
      </section>
    )}

    <div class="bands">
      <a class="briefing" href={lang === 'hi' ? '/briefing' : '/en/briefing'}>
        <span class="b-kicker">{L.briefing}</span>
        <span class="serif b-title">{lang === 'hi' ? 'आज की ज़रूरी बातें, कुछ मिनट में' : "Today's essentials in a few minutes"} ›</span>
      </a>
      <LocalStrip lang={lang} />
    </div>

    {deadlines.length > 0 && (
      <section class="deadlines" aria-labelledby="dl-h">
        <h2 id="dl-h"><a href={`${p}/deadlines`}>{L.deadlines} ›</a></h2>
        <DeadlineList lang={lang} items={deadlines} />
      </section>
    )}

    {sectionOrder.filter((sec) => stories.some((s) => s.data.category === sec)).map((sec) => (
      <SectionBlock lang={lang} section={sec} stories={stories.filter((s) => s.data.category === sec)} />
    ))}
  </main>
</Base>
<style>
  .home { display: flex; flex-direction: column; gap: 2.5rem; padding-top: 1.25rem; }
  .top { display: grid; gap: 1.5rem; }
  .secondary { display: grid; gap: 1.25rem; }
  @media (min-width: 740px) {
    .top { grid-template-columns: 2fr 1fr; }
  }
  @media (min-width: 1024px) {
    .top { grid-template-columns: 5fr 3fr; column-gap: 2rem; }
  }
  .bands { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  @media (min-width: 740px) { .bands { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }
  .briefing { display: flex; flex-direction: column; justify-content: center; gap: 0.35rem; background: var(--band-bg); color: var(--band-text); padding: 1.25rem 1.5rem; border-radius: 4px; }
  .b-kicker { color: #8fd9bd; font-weight: 600; font-size: 0.9rem; }
  .b-title { font-size: 1.3rem; font-weight: 600; line-height: 1.45; }
  .briefing:hover .b-title { text-decoration: underline; }
  .deadlines { border-top: 4px solid var(--c-health); padding-top: 0.25rem; }
  .deadlines h2 { margin: 0 0 0.5rem; font-size: 1.25rem; }
  .deadlines h2 a { display: inline-flex; align-items: center; min-height: 44px; color: var(--c-health); }
</style>

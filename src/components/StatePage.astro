---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
import DistrictGrid from './DistrictGrid.astro';
import LocalStrip from './LocalStrip.astro';
import { t, type Lang } from '../lib/i18n';
import { districtBySlug, districtsOf, stateByCode, statePath } from '../lib/places';
interface Props { lang: Lang; code: string }
const { lang, code } = Astro.props;
const L = t[lang];
const st = stateByCode(code)!;
const n = districtsOf(code).length;
const stories = (await getCollection('stories', ({ data }) => data.lang === lang
  && (data.state === code || data.districts.some((x) => districtBySlug(x)?.state === code))))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const counts: Record<string, number> = {};
for (const s of stories) for (const d of s.data.districts) counts[d] = (counts[d] ?? 0) + 1;
const name = st[lang];
---
<Base lang={lang} section={code} title={`${name} | Kasba`} altPath={statePath(lang === 'hi' ? 'en' : 'hi', code)}
  description={lang === 'hi' ? `${st.hi} के सभी ${n} ज़िलों की ज़रूरी सरकारी सूचनाएँ, आसान हिंदी में।` : `Official updates for all ${n} districts of ${st.en}, in simple language.`}>
  <main class="page state">
    <h1 class="serif">{name}</h1>
    <section aria-labelledby="st-h">
      <h2 id="st-h">{L.stateNews}</h2>
      {stories.length ? <div class="grid">{stories.slice(0, 12).map((s) => <StoryCard story={s} size="standard" />)}</div> : <p class="muted">{L.stateSoon(name)}</p>}
    </section>
    <section aria-labelledby="dg-h">
      <h2 id="dg-h">{L.allDistricts} ({n})</h2>
      <DistrictGrid lang={lang} state={code} counts={counts} />
    </section>
  </main>
</Base>
<style>
  .state { padding-top: 2rem; display: flex; flex-direction: column; gap: 2rem; }
  h1 { margin: 0; font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.1; }
  h2 { margin: 0 0 0.75rem; font-family: var(--display); font-weight: 400; font-size: 1.6rem; }
  .grid { display: grid; gap: var(--gap); }
  @media (min-width: 740px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

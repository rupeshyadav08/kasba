---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
import DistrictGrid from './DistrictGrid.astro';
import { t, type Lang } from '../lib/i18n';
import { state, statePath } from '../lib/places';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = t[lang];
const stories = (await getCollection('stories', ({ data }) => data.lang === lang && (data.state === state.code || data.districts.length > 0)))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const counts: Record<string, number> = {};
for (const s of stories) for (const d of s.data.districts) counts[d] = (counts[d] ?? 0) + 1;
const name = state[lang];
---
<Base lang={lang} section="up" title={`${name} | Kasba`} altPath={statePath(lang === 'hi' ? 'en' : 'hi')}
  description={lang === 'hi' ? 'उत्तर प्रदेश के सभी 75 ज़िलों की ज़रूरी सरकारी सूचनाएँ, आसान हिंदी में।' : 'Official updates for all 75 districts of Uttar Pradesh, in simple language.'}>
  <main class="page state">
    <h1 class="serif">{name}</h1>
    <section aria-labelledby="st-h">
      <h2 id="st-h">{L.stateNews}</h2>
      {stories.length ? <div class="grid">{stories.slice(0, 12).map((s) => <StoryCard story={s} size="standard" />)}</div> : <p class="muted">{L.stateSoon}</p>}
    </section>
    <section aria-labelledby="dg-h">
      <h2 id="dg-h">{L.allDistricts} (75)</h2>
      <DistrictGrid lang={lang} counts={counts} />
    </section>
  </main>
</Base>
<style>
  .state { padding-top: 1.25rem; display: flex; flex-direction: column; gap: 2rem; }
  h1 { margin: 0; font-size: 2.25rem; color: var(--local-ink); border-bottom: 4px solid var(--local-ink); padding-bottom: 0.25rem; }
  h2 { margin: 0 0 0.75rem; font-size: 1.25rem; }
  .grid { display: grid; gap: 1.5rem; }
  @media (min-width: 740px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
import SectionNav from './SectionNav.astro';
import { categories, type Lang } from '../lib/i18n';
interface Props { lang: Lang; category: keyof typeof categories }
const { lang, category } = Astro.props;
const stories = (await getCollection('stories', ({ data }) => data.lang === lang && data.category === category))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const name = categories[category][lang];
const alt = lang === 'hi' ? `/en/section/${category}` : `/section/${category}`;
---
<Base lang={lang} title={`${name} | Kasba`} description={lang === 'hi' ? `${name}: आधिकारिक सूचनाएँ, आसान भाषा में` : `${name}: official updates in simple language`} altPath={alt}>
  <main class="wrap section">
    <h1 class="serif">{name}</h1>
    <SectionNav lang={lang} current={category} />
    {stories.length === 0
      ? <p class="muted">{lang === 'hi' ? 'इस विषय पर जल्द ख़बरें आएँगी।' : 'Stories in this section are coming soon.'}</p>
      : stories.map((s) => <StoryCard story={s} />)}
  </main>
</Base>
<style>
  .section { display: flex; flex-direction: column; gap: 1.75rem; padding-top: 1.5rem; }
  h1 { margin: 0; font-size: 2rem; }
</style>

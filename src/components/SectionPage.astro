---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
import { categories, secColor, sectionPath, storyPath, t, type Lang, type Section } from '../lib/i18n';
interface Props { lang: Lang; category: Section }
const { lang, category } = Astro.props;
const stories = (await getCollection('stories', ({ data }) => data.lang === lang && data.category === category))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const [lead, ...rest] = stories;
const name = categories[category][lang];
const alt = lang === 'hi' ? `/en/section/${category}` : `/section/${category}`;
const abs = (p: string) => new URL(p, Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name, inLanguage: lang, url: abs(sectionPath(lang, category)),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: stories.slice(0, 20).map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(storyPath(lang, s.data.storyId)) })),
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t[lang].home, item: abs(lang === 'hi' ? '/' : '/en') },
      { '@type': 'ListItem', position: 2, name, item: abs(sectionPath(lang, category)) },
    ],
  },
];
---
<Base lang={lang} title={`${name} | Kasba`} section={category}
  description={lang === 'hi' ? `${name}: आधिकारिक सूचनाएँ, आसान भाषा में` : `${name}: official updates in simple language`} altPath={alt} jsonLd={jsonLd}>
  <main class="page section" style={secColor(category)}>
    <h1 class="serif">{name}</h1>
    {!lead && <p class="muted">{t[lang].soon}</p>}
    {lead && (
      <div class="grid">
        <div class="lead"><StoryCard story={lead} size="lead" showKicker={false} /></div>
        {rest.map((s) => <StoryCard story={s} size="standard" showKicker={false} />)}
      </div>
    )}
  </main>
</Base>
<style>
  .section { padding-top: 1.25rem; display: flex; flex-direction: column; gap: 1.5rem; }
  h1 { margin: 0; font-size: 2.25rem; color: var(--sec); border-bottom: 4px solid var(--sec); padding-bottom: 0.25rem; }
  .grid { display: grid; gap: 1.5rem; }
  @media (min-width: 740px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .lead { grid-column: 1 / -1; } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .lead { grid-column: span 2; grid-row: span 2; } }
</style>

---
// One story teaser, drawn as a borderless tinted card.
// "hero" (front-page lead: big picture and headline), "tall" (picture on top, column card),
// "lead" (section-page lead), "standard" (picture, headline, summary), "compact" (headline
// with a small picture beside it). Headlines like "PM-KISAN: ..." get their topic marked
// with a highlighter block on the hero and section leads.
import type { CollectionEntry } from 'astro:content';
import { categories, dateFmt, secColor, storyPath, t } from '../lib/i18n';
import { thumb } from '../lib/img';
interface Props { story: CollectionEntry<'stories'>; size?: 'hero' | 'tall' | 'lead' | 'standard' | 'compact'; showKicker?: boolean; highlight?: 'red' | 'beige'; eager?: boolean }
const { story, size = 'standard', showKicker = true, highlight, eager = false } = Astro.props;
const d = story.data;
const L = t[d.lang];
const Tag = size === 'hero' || size === 'lead' ? 'h2' : 'h3';
const wide = size === 'hero' || size === 'lead';
const mark = highlight ?? (wide ? 'red' : undefined);
const colon = d.title.indexOf(':');
const [topic, rest] = mark && colon > 0 && colon < 40 ? [d.title.slice(0, colon), d.title.slice(colon)] : ['', d.title];
const sec = categories[d.category][d.lang];
// The lead uses the full picture; every other card the small copy.
// Headline cards (credit "Kasba") are for share previews and Discover only; next to the
// headline itself they would just repeat it.
const pic = d.image && d.image.credit !== 'Kasba' && (wide ? d.image.src : thumb(d.image.src));
---
<article class={`card ${size}${pic ? ' has-pic' : ''}`} style={secColor(d.category)}>
  <a href={storyPath(d.lang, d.storyId)}>
    {size !== 'compact' && (pic
      ? <img class="pic" src={pic} alt="" width={wide ? 1200 : 480} height={wide ? 675 : 270} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
      : <span class="pic blank" aria-hidden="true"><span class="serif">{sec}</span></span>)}
    <span class="text">
      <span class="meta">
        {showKicker && <span class="kicker">{sec}</span>}
        <time class="date" datetime={d.published.toISOString()} data-ago>{dateFmt(d.lang, d.published)}</time>
      </span>
      <Tag class="serif hl">{topic && <span class={`hl-${mark}`}>{topic}</span>}{rest}</Tag>
      {size !== 'compact' && <p class="sum">{d.summary}</p>}
      {wide && <p class="mean"><strong>{L.meaning}:</strong> {d.meaning}</p>}
    </span>
    {size === 'compact' && pic && <img class="thumb" src={pic} alt="" width="480" height="270" loading="lazy" decoding="async" />}
  </a>
</article>
<style>
  .card { background: var(--card); border-radius: var(--r-card); overflow: hidden; }
  .card a { display: flex; flex-direction: column; height: 100%; }
  .text { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.9rem 1rem 1.1rem; min-width: 0; }
  @media (min-width: 740px) { .text { padding: 1.1rem 1.3rem 1.3rem; } }
  .card :is(h2, h3) { margin: 0; line-height: 1.25; overflow-wrap: anywhere; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.1rem 0.75rem; align-items: baseline; font-family: var(--sans); font-size: 0.85rem; }
  .date { color: var(--muted); }
  .sum { margin: 0; color: var(--text-soft); line-height: 1.55; font-size: 1rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card a:hover .hl { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }

  .pic { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--line); }
  .card a:hover img { filter: brightness(1.04); }
  /* A story without a picture gets a calm panel in its section's colour instead of a hole. */
  .blank { display: grid; place-items: center; background: color-mix(in srgb, var(--sec) 13%, var(--bg)); color: color-mix(in srgb, var(--sec) 55%, var(--bg)); font-size: clamp(1.6rem, 4vw, 2.6rem); }

  .hero h2 { font-size: clamp(1.7rem, 3.6vw, 2.9rem); line-height: 1.15; }
  @media (min-width: 1000px) { .hero .pic { aspect-ratio: 2 / 1; } }
  .hero .sum { font-size: 1.08rem; }
  .hero .text { gap: 0.7rem; }
  @media (min-width: 740px) { .hero .text { padding: 1.4rem 1.6rem 1.6rem; } }
  .lead h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1.18; }
  .tall h3 { font-size: clamp(1.25rem, 1.9vw, 1.5rem); }
  .standard h3 { font-size: 1.25rem; }
  :is(.tall, .standard) .sum { font-size: 0.97rem; }

  .compact { background: var(--card-2); }
  .compact a { flex-direction: row; align-items: flex-start; gap: 0.9rem; padding: 0.85rem 1rem; }
  .compact .text { padding: 0; flex: 1; gap: 0.3rem; }
  .compact h3 { font-size: 1.08rem; line-height: 1.38; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .thumb { flex: 0 0 auto; width: 6rem; height: 4.5rem; object-fit: cover; border-radius: 10px; background: var(--line); }

  .mean { display: none; margin: 0; padding: 0.8rem 1rem; background: var(--bg); border-radius: var(--r-tile); color: var(--text-soft); line-height: 1.55; font-size: 0.97rem; }
  @media (min-width: 740px) { .mean { display: block; } }
  .mean strong { color: var(--text); font-weight: 600; }
</style>

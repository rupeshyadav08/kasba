---
import type { CollectionEntry } from 'astro:content';
import { categories, dateFmt, storyPath, t } from '../lib/i18n';
interface Props { story: CollectionEntry<'stories'>; lead?: boolean }
const { story, lead = false } = Astro.props;
const d = story.data;
const href = storyPath(d.lang, d.storyId);
---
{lead ? (
  <article class="lead">
    <div class="kicker">{categories[d.category][d.lang]}</div>
    <h1 class="serif"><a href={href}>{d.title}</a></h1>
    <p class="serif summary">{d.summary}</p>
    <div class="muted">{d.source.name} · {dateFmt(d.lang, d.published)}</div>
  </article>
) : (
  <a class="card" href={href}>
    <span class="serif title">{d.title}</span>
    <span class="muted">{categories[d.category][d.lang]} · {dateFmt(d.lang, d.published)}</span>
  </a>
)}
<style>
  .lead { display: flex; flex-direction: column; gap: 0.75rem; padding-top: 1rem; }
  .lead h1 { margin: 0; font-size: 1.9rem; line-height: 1.35; font-weight: 700; }
  .summary { margin: 0; font-size: 1.0625rem; line-height: 1.75; color: var(--text-soft); }
  .card { display: flex; flex-direction: column; gap: 0.35rem; }
  .title { font-size: 1.25rem; line-height: 1.5; font-weight: 600; }
</style>

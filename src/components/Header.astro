---
import { categories, sectionOrder, sectionPath, secColor, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; altPath?: string; current?: string }
const { lang, altPath, current } = Astro.props;
const home = lang === 'hi' ? '/' : '/en';
const other = altPath ?? (lang === 'hi' ? '/en' : '/');
const today = new Intl.DateTimeFormat(lang === 'hi' ? 'hi-IN' : 'en-IN', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata',
}).format(new Date());
---
<header class="masthead">
  <div class="page top">
    <div class="meta">
      <span class="date">{today}</span>
      <a href={other} class="lang" hreflang={lang === 'hi' ? 'en' : 'hi'}>{t[lang].switchLang}</a>
    </div>
    <a href={home} class="logo serif" aria-label="Kasba home">कस्बा<span class="dot" aria-hidden="true"></span></a>
    <p class="tagline">{t[lang].tagline}</p>
  </div>
  <nav class="pillars" aria-label={t[lang].sections}>
    <ul class="page">
      {sectionOrder.map((c) => (
        <li style={secColor(c)}>
          <a href={sectionPath(lang, c)} aria-current={current === c ? 'page' : undefined}>{categories[c][lang]}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
<style>
  .masthead { border-bottom: 1px solid var(--line); }
  .top { display: grid; grid-template-columns: 1fr; padding-top: 0.5rem; padding-bottom: 0.5rem; }
  .meta { display: flex; justify-content: space-between; align-items: center; font-size: 0.8125rem; color: var(--muted); }
  .lang { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: flex-end; font-weight: 600; color: var(--text); }
  .logo { font-weight: 700; font-size: 2.75rem; line-height: 1.1; display: inline-flex; align-items: baseline; gap: 0.35rem; justify-self: start; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .tagline { margin: 0.1rem 0 0; color: var(--muted); font-size: 0.9375rem; }
  @media (min-width: 740px) {
    .top { grid-template-columns: 1fr auto; grid-template-areas: 'tag logo' 'meta logo'; align-items: end; column-gap: 1rem; padding-top: 1rem; padding-bottom: 0.75rem; }
    .logo { grid-area: logo; font-size: 4rem; justify-self: end; }
    .meta { grid-area: meta; justify-content: flex-start; gap: 1.25rem; }
    .tagline { grid-area: tag; font-size: 1rem; }
  }
  .pillars { border-top: 1px solid var(--line); position: relative; }
  /* On phones the section bar scrolls sideways; a soft fade on the right shows there is more. */
  .pillars::after { content: ''; position: absolute; top: 0; right: 0; bottom: 0; width: 2rem; background: linear-gradient(to right, transparent, var(--bg)); pointer-events: none; }
  @media (min-width: 1000px) { .pillars::after { display: none; } }
  .pillars ul { list-style: none; margin: 0 auto; display: flex; overflow-x: auto; scrollbar-width: none; }
  .pillars li { flex: 0 0 auto; border-left: 1px solid var(--line); }
  .pillars li:first-child { border-left: 0; }
  .pillars a { display: flex; align-items: center; min-height: 48px; padding: 0 0.85rem; font-weight: 600; font-size: 0.975rem; white-space: nowrap; border-bottom: 4px solid transparent; }
  .pillars a:hover, .pillars a[aria-current='page'] { border-bottom-color: var(--sec); color: var(--sec); }
  @media (min-width: 740px) { .pillars a { min-width: 7.5rem; font-size: 1.05rem; padding: 0 1rem; } }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import AffiliateBox from './AffiliateBox.astro';
import StoryCard from './StoryCard.astro';
import { districtBySlug, districtPath, stateByCode, statePath } from '../lib/places';
import Base from '../layouts/Base.astro';
import { org } from '../lib/site';
import { calendarLink, categories, dateFmt, readMinutes, secColor, sectionPath, storyPath, t } from '../lib/i18n';
interface Props { story: CollectionEntry<'stories'>; altPath?: string }
const { story, altPath } = Astro.props;
const d = story.data;
const L = t[d.lang];
const { Content } = await render(story);
const related = (await getCollection('stories', ({ data }) => data.lang === d.lang && data.storyId !== d.storyId))
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category) || b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 4);
// Glossary entries whose words appear in this story, shown as a "words in this story" box.
const text = [d.title, d.summary, d.meaning, ...d.keyFacts, story.body ?? ''].join(' ').toLowerCase();
const terms = (await getCollection('glossary', ({ data }) => data.lang === d.lang))
  .filter((g) => g.data.match.some((w) => text.includes(w.toLowerCase())));
const glossaryPath = d.lang === 'hi' ? '/shabdkosh' : '/en/shabdkosh';
const minutes = readMinutes([d.summary, d.meaning, story.body ?? ''].join(' '), d.lang);
const words = [d.summary, d.meaning, ...d.keyFacts, story.body ?? ''].join(' ').trim().split(/\s+/).length;
// The state a story is about: stated, or the state of its first district.
const st = stateByCode(d.state ?? districtBySlug(d.districts[0] ?? '')?.state ?? '');
const places = [
  ...(d.state && st ? [{ '@type': 'State', name: st[d.lang], containedInPlace: { '@type': 'Country', name: 'India' } }] : []),
  ...d.districts.map((slug) => ({ '@type': 'AdministrativeArea', name: districtBySlug(slug)![d.lang], containedInPlace: { '@type': 'State', name: stateByCode(districtBySlug(slug)!.state)![d.lang] } })),
];
const url = new URL(storyPath(d.lang, d.storyId), Astro.site).toString();
const home = new URL(d.lang === 'hi' ? '/' : '/en', Astro.site).toString();
const image = new URL(d.image?.src ?? `/og/${d.category}.png`, Astro.site).toString();
// WhatsApp is how most of Kasba's readers pass news on, so the share text carries the useful line too.
const shareText = `${d.title}\n\n${L.meaning}: ${d.meaning}\n\n${url}`;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
const calendar = d.deadline && calendarLink(`${d.deadline.label} (Kasba)`, d.deadline.date, `${d.title}\n${url}`);

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'NewsArticle',
    headline: d.title, description: d.summary, inLanguage: d.lang,
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    image: [image],
    articleSection: categories[d.category][d.lang],
    // Kasba publishes under the desk's name, not a person's.
    author: { '@type': 'Organization', name: d.author, url: new URL(d.lang === 'hi' ? '/about' : '/en/about', Astro.site).toString() },
    publisher: org,
    mainEntityOfPage: url,
    isAccessibleForFree: true,
    wordCount: words,
    // The official notice the story explains, so search engines and AI answers can trace each fact.
    isBasedOn: {
      '@type': 'CreativeWork', name: d.source.title, url: d.source.url,
      datePublished: d.source.date.toISOString().slice(0, 10),
      publisher: { '@type': 'GovernmentOrganization', name: d.source.name },
    },
    ...(places.length && { contentLocation: places }),
    // Voice assistants read these parts aloud.
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.summary', '.meaning p'] },
    ...(d.correction && { correction: { '@type': 'CorrectionComment', text: d.correction } }),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: L.home, item: home },
      { '@type': 'ListItem', position: 2, name: categories[d.category][d.lang], item: new URL(sectionPath(d.lang, d.category), Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base lang={d.lang} title={`${d.title} | Kasba`} description={d.summary} altPath={altPath} jsonLd={jsonLd} type="article" section={d.category} image={image} markdown={`${storyPath(d.lang, d.storyId)}.md`}>
  <div class="layout" style={secColor(d.category)}>
  <main class="story">
    <nav aria-label="breadcrumb" class="crumbs"><a href={d.lang === 'hi' ? '/' : '/en'}>{L.home}</a> › <a class="sec" href={sectionPath(d.lang, d.category)}>{categories[d.category][d.lang]}</a></nav>
    {d.storyType === 'record' && <p class="record"><strong>⚖️ {L.fromRecord}</strong> · {L.fromRecordNote}</p>}
    <h1 class="serif">{d.title}</h1>
    <button type="button" class="pill listen" data-lang={d.lang === 'hi' ? 'hi-IN' : 'en-IN'} hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M7 4v16l13-8z"/></svg>
      <span class="l-text">{d.lang === 'hi' ? 'सुनें' : 'Listen'}</span> <span class="l-min">({minutes} {d.lang === 'hi' ? 'मिनट' : 'min'})</span>
    </button>
    <p class="summary">{d.summary}</p>
    {d.image && (
      <figure class="lead-img">
        <img src={d.image.src} width="1200" height="675" alt="" fetchpriority="high" decoding="async" />
        <figcaption>{d.lang === 'hi' ? 'सांकेतिक तस्वीर' : 'Representative image'} · {d.image.credit}</figcaption>
      </figure>
    )}
    <div class="actions">
      <a class="act" href={whatsapp} rel="noopener" target="_blank">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
        {L.share}
      </a>
      {calendar && <a class="act" href={calendar} rel="noopener" target="_blank">📅 {L.addCalendar}: {dateFmt(d.lang, d.deadline!.date)}</a>}
      <span class="act m-date"><time datetime={d.published.toISOString()}>{dateFmt(d.lang, d.published)}</time></span>
      <span class="act time">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        {minutes} {L.minRead}
      </span>
    </div>
    {d.correction && <p class="correction"><strong>{L.correction}:</strong> {d.correction}</p>}

    <section class="meaning" aria-labelledby="meaning-h">
      <h2 id="meaning-h">{L.meaning}</h2>
      <p class="serif">{d.meaning}</p>
    </section>

    <section aria-labelledby="facts-h">
      <h2 id="facts-h" class="serif">{L.keyFacts}</h2>
      <ul class="facts">{d.keyFacts.map((f) => <li>{f}</li>)}</ul>
    </section>

    <div class="serif body"><Content /></div>

    <section aria-labelledby="faq-h">
      <h2 id="faq-h" class="serif">{L.faq}</h2>
      {d.faq.map((f) => <div class="qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>

    <AffiliateBox lang={d.lang} category={d.category} />

    {(d.state || d.districts.length > 0) && (
      <nav class="places" aria-label={L.districtsLabel}>
        {d.state && st && <a href={statePath(d.lang, st.code)}>{st[d.lang]}</a>}
        {d.districts.map((slug) => <a href={districtPath(d.lang, slug)}>{districtBySlug(slug)![d.lang]}</a>)}
      </nav>
    )}

    {terms.length > 0 && (
      <section class="words" aria-labelledby="words-h">
        <h2 id="words-h">{L.glossary}</h2>
        <dl>{terms.map((g) => <div><dt><a href={`${glossaryPath}#${g.data.termId}`}>{g.data.term}</a></dt><dd>{g.data.short}</dd></div>)}</dl>
      </section>
    )}

    <section class="source" aria-label={L.source}>
      <p><strong>{L.source}:</strong> {d.source.name}, "{d.source.title}", {dateFmt(d.lang, d.source.date)}. <a href={d.source.url} rel="noopener">{L.viewSource}</a></p>
      <p>{d.autoPublished ? L.aiNoteAuto : <>{L.checked}: {dateFmt(d.lang, d.updated ?? d.published)}. {L.aiNote}</>} <a href="mailto:admin@kasba.co.in">{L.reportError}</a></p>
    </section>
  </main>
  <aside class="info" aria-label={L.source}>
    <dl>
      <div><dt>{d.author}</dt><dd>{L.published} <time datetime={d.published.toISOString()}>{dateFmt(d.lang, d.published)}</time>{d.updated && <><br />{L.updated} <time datetime={d.updated.toISOString()}>{dateFmt(d.lang, d.updated)}</time></>}</dd></div>
      <div><dt><a href={d.source.url} rel="noopener">{d.source.name}</a></dt><dd>{L.source}</dd></div>
      <div><dt><a href={sectionPath(d.lang, d.category)}>{categories[d.category][d.lang]}</a></dt><dd>{d.lang === 'hi' ? 'विषय' : 'Section'}</dd></div>
    </dl>
  </aside>
  {related.length > 0 && (
    <aside class="rail" aria-label={L.moreIn}>
      <h2 class="rail-h">{L.moreIn}</h2>
      {related.map((r) => <StoryCard story={r} size="compact" />)}
    </aside>
  )}
  </div>
</Base>
<script is:inline>
  // "Listen" reads the story aloud with the phone's own voice (no cost, works offline);
  // the button only appears where the browser has a voice for the story's language.
  (() => {
    const btn = document.querySelector('.listen');
    if (!btn || !('speechSynthesis' in window)) return;
    const lang = btn.dataset.lang;
    const label = btn.querySelector('.l-text');
    const idle = label.textContent;
    const ready = () => speechSynthesis.getVoices().some((v) => v.lang.replace('_', '-').startsWith(lang.slice(0, 2)));
    const reveal = () => { if (ready()) btn.hidden = false; };
    reveal();
    speechSynthesis.addEventListener?.('voiceschanged', reveal);
    btn.addEventListener('click', () => {
      if (speechSynthesis.speaking) { speechSynthesis.cancel(); label.textContent = idle; return; }
      const parts = ['h1', '.summary', '.meaning p', '.facts', '.body'].map((q) => document.querySelector(q)?.innerText ?? '');
      const u = new SpeechSynthesisUtterance(parts.join('. '));
      u.lang = lang; u.rate = 0.95;
      u.onend = () => { label.textContent = idle; };
      label.textContent = lang === 'hi-IN' ? 'रोकें' : 'Stop';
      speechSynthesis.speak(u);
    });
  })();
</script>
<style>
  .lead-img { margin: 16px 0 8px; }
  .lead-img img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; background: var(--line, #eee); }
  .lead-img figcaption { font-size: 12px; color: var(--muted, #666); margin-top: 4px; }
  .layout { display: grid; gap: 3rem; padding: 2rem 1rem 0; max-width: var(--page); margin: 0 auto; }
  @media (min-width: 740px) { .layout { padding: 3.5rem 1.6rem 0; } }
  @media (min-width: 1100px) {
    .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 44rem) minmax(0, 1fr); column-gap: 3rem; grid-template-rows: auto 1fr; }
    .story { grid-column: 2; grid-row: 1 / span 2; }
    .info { grid-column: 3; grid-row: 1; padding-top: 4.5rem; }
    .rail { grid-column: 3; grid-row: 2; }
  }
  .story { display: flex; flex-direction: column; gap: 1.6rem; min-width: 0; }
  .crumbs { font-size: 0.95rem; color: var(--muted); }
  .crumbs .sec { color: var(--sec); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; }
  .info dl { margin: 0; display: grid; gap: 1.6rem; }
  .info dt { font-size: 1.05rem; }
  .info dt a:hover { text-decoration: underline; }
  .info dd { margin: 0.1rem 0 0; color: var(--muted); font-size: 0.92rem; }
  .rail { display: flex; flex-direction: column; gap: var(--gap); align-self: start; }
  .rail-h { font-family: var(--display); font-weight: 400; font-size: 1.5rem; margin: 0 0 0.25rem; }
  h1 { margin: 0; font-size: clamp(2.1rem, 5vw, 3.9rem); line-height: 1.12; }
  h2 { margin: 0 0 0.6rem; font-size: 1.6rem; font-weight: 400; }
  .listen { align-self: flex-start; }
  .listen[hidden] { display: none; }
  .l-min { color: var(--muted); }
  .listen:hover .l-min { color: inherit; }
  .summary { margin: 0; font-size: 1.25rem; line-height: 1.65; color: var(--text-soft); }
  .record { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .record strong { color: var(--text); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.25rem 1.75rem; font-size: 1.05rem; }
  .act { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 44px; }
  a.act:hover { text-decoration: underline; text-underline-offset: 4px; }
  .time, .m-date { color: var(--text-soft); }
  @media (min-width: 1100px) { .m-date { display: none; } }
  h2 { font-family: var(--display); }
  .correction { background: var(--cream); padding: 0.9rem 1.1rem; border-radius: var(--r-tile); margin: 0; }
  .meaning { background: var(--cream); padding: 1.4rem 1.5rem; border-radius: var(--r-card); }
  .meaning h2 { font-size: 1.35rem; }
  .meaning p { margin: 0; line-height: 1.75; font-family: var(--serif); font-size: 1.1rem; }
  .facts { margin: 0; padding-left: 1.25rem; line-height: 1.8; font-size: 1.08rem; color: var(--text-soft); }
  .body { font-family: var(--serif); font-size: 1.2rem; line-height: 1.8; color: var(--text-soft); }
  .body :global(p) { margin: 0 0 1.5em; }
  .body :global(h2) { font-family: var(--display); font-weight: 400; color: var(--text); font-size: 1.7rem; line-height: 1.2; margin: 2.25rem 0 0.75rem; }
  .qa { background: var(--card); border-radius: var(--r-tile); padding: 1rem 1.2rem; margin-bottom: var(--gap); }
  .qa h3 { margin: 0; font-size: 1.1rem; font-weight: 600; }
  .qa p { margin: 0.3rem 0 0; color: var(--text-soft); }
  .places { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .places a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border-radius: 999px; border: 1px solid var(--text); font-size: 0.95rem; }
  .places a:hover { background: var(--text); color: var(--bg); }
  .words { background: var(--card); border-radius: var(--r-card); padding: 1.25rem 1.5rem; }
  .words h2 { font-size: 1.35rem; }
  .words dl { margin: 0; display: grid; gap: 0.5rem; }
  .words dt a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: underline; text-decoration-color: var(--line); }
  .words dd { margin: 0; color: var(--text-soft); font-size: 0.97rem; }
  .source { border-top: 1px solid var(--line); padding-top: 1rem; font-size: 0.95rem; color: var(--muted); }
  .source a { color: var(--text); text-decoration: underline; display: inline-block; padding: 0.6rem 0; }
</style>

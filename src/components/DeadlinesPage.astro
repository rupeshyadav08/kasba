---
import Base from '../layouts/Base.astro';
import DeadlineList from './DeadlineList.astro';
import { upcomingDeadlines } from '../lib/deadlines';
import { storyPath, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = t[lang];
const items = await upcomingDeadlines(lang);
const path = lang === 'hi' ? '/deadlines' : '/en/deadlines';
// A plain list of the story pages; each story carries its own NewsArticle data.
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: L.deadlines, url: new URL(path, Astro.site).toString(),
  itemListElement: items.map(({ story }, i) => ({
    '@type': 'ListItem', position: i + 1, name: story.data.deadline!.label,
    url: new URL(storyPath(lang, story.data.storyId), Astro.site).toString(),
  })),
}];
---
<Base lang={lang} title={`${L.deadlines} | Kasba`} description={L.deadlinesNote} altPath={lang === 'hi' ? '/en/deadlines' : '/deadlines'} jsonLd={jsonLd}>
  <main class="wrap dpage">
    <h1 class="serif">{L.deadlines}</h1>
    <p class="muted">{L.deadlinesNote}</p>
    {items.length ? <DeadlineList lang={lang} items={items} calendar /> : <p>{L.noDeadlines}</p>}
  </main>
</Base>
<style>
  .dpage { padding-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
  h1 { margin: 0; font-size: 2rem; border-top: 4px solid var(--c-health); padding-top: 0.5rem; }
  .muted { margin: 0; }
</style>

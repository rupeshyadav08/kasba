---
import { categories, sectionOrder, sectionPath, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = lang === 'hi' ? '' : '/en';
const L = t[lang];
const about = lang === 'hi'
  ? [['हमारे बारे में', '/about'], ['स्रोत और AI', '/sources-ai'], ['संपर्क', '/contact'], ['कस्बा ब्रीफ़िंग', '/briefing'], ['आख़िरी तारीख़ें', '/deadlines'], ['शब्दकोश', '/shabdkosh']]
  : [['About', '/about'], ['Sources and AI', '/sources-ai'], ['Contact', '/contact'], ['Kasba Briefing', '/briefing'], ['Last dates', '/deadlines'], ['Glossary', '/shabdkosh']];
const policies = lang === 'hi'
  ? [['संपादकीय नीति', '/editorial-policy'], ['सुधार नीति', '/corrections'], ['आचार संहिता', '/code-of-ethics'], ['शिकायत निवारण', '/grievance'], ['निजता', '/privacy'], ['नियम व शर्तें', '/terms']]
  : [['Editorial policy', '/editorial-policy'], ['Corrections', '/corrections'], ['Code of ethics', '/code-of-ethics'], ['Grievance redressal', '/grievance'], ['Privacy', '/privacy'], ['Terms', '/terms']];
---
<footer class="site-footer">
  <div class="page grid">
    <div class="brand">
      <div class="logo">कस्बा</div>
      <p>{L.siteNote}</p>
      <p><a class="mail" href="mailto:admin@kasba.co.in">admin@kasba.co.in</a></p>
    </div>
    <nav aria-label={L.sections}>
      <h2>{L.sections}</h2>
      <ul>{sectionOrder.map((c) => <li><a href={sectionPath(lang, c)}>{categories[c][lang]}</a></li>)}</ul>
    </nav>
    <nav aria-label={L.aboutKasba}>
      <h2>{L.aboutKasba}</h2>
      <ul>{about.map(([label, href]) => <li><a href={`${p}${href}`}>{label}</a></li>)}</ul>
    </nav>
    <nav aria-label={L.policies}>
      <h2>{L.policies}</h2>
      <ul>{policies.map(([label, href]) => <li><a href={`${p}${href}`}>{label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="page copy">© {new Date().getFullYear()} Kasba · kasba.co.in</div>
</footer>
<style>
  .site-footer { margin: 4rem var(--gap) var(--gap); background: var(--dark); color: var(--band-text); padding-top: 2.25rem; border-radius: var(--r-card); }
  @media (min-width: 740px) { .site-footer { margin: 4rem 1.6rem 1.6rem; } }
  .page { padding: 0 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .brand { grid-column: 1 / -1; }
  @media (min-width: 900px) { .grid { grid-template-columns: 2fr 1fr 1fr 1fr; } .brand { grid-column: auto; } }
  .logo { font-family: var(--display); font-size: 2.5rem; font-weight: 600; line-height: 1.1; }
  .mail { display: inline-flex; min-height: 44px; align-items: center; }
  p { margin: 0.5rem 0 0; font-size: 0.95rem; color: #c3c3c3; max-width: 28rem; }
  h2 { font-family: var(--display); font-weight: 400; font-size: 1.15rem; margin: 0 0 0.4rem; color: #fff; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: inline-flex; min-height: 40px; align-items: center; font-size: 0.97rem; color: #d6d6d6; }
  li a:hover, p a:hover { text-decoration: underline; color: #fff; }
  .copy { border-top: 1px solid #333; margin-top: 2rem; padding-top: 1rem; padding-bottom: 1.5rem; font-size: 0.85rem; color: #a8a8a8; }
</style>

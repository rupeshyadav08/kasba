---
import LocalStrip from './LocalStrip.astro';
import { categories, sectionOrder, sectionPath, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = lang === 'hi' ? '' : '/en';
const L = t[lang];
// Share row: Kasba has no social accounts yet, so these share the site instead.
const home = new URL(lang === 'hi' ? '/' : '/en', Astro.site).toString();
const shareUrl = encodeURIComponent(home);
const shareText = encodeURIComponent(lang === 'hi' ? 'कस्बा: छोटे शहरों की बड़ी ख़बरें' : 'Kasba: big news for small towns');
const tiles = [
  { name: 'WhatsApp', href: `https://wa.me/?text=${shareText}%20${shareUrl}`,
    d: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z' },
  { name: 'Telegram', href: `https://t.me/share/url?url=${shareUrl}&text=${shareText}`,
    d: 'M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.8-3.6-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2l-11 6.9-4.7-1.5c-1-.3-1-1 .2-1.5L20.6 3c.9-.3 1.6.2 1.3 1.3Z' },
  { name: 'X', href: `https://x.com/intent/post?url=${shareUrl}&text=${shareText}`,
    d: 'M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L2 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z' },
  { name: 'RSS', href: lang === 'hi' ? '/rss.xml' : '/en/rss.xml',
    d: 'M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3Zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7V9Zm2 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z' },
];
const about = lang === 'hi'
  ? [['हमारे बारे में', '/about'], ['स्रोत और AI', '/sources-ai'], ['संपर्क', '/contact'], ['कस्बा ब्रीफ़िंग', '/briefing'], ['आख़िरी तारीख़ें', '/deadlines'], ['शब्दकोश', '/shabdkosh']]
  : [['About', '/about'], ['Sources and AI', '/sources-ai'], ['Contact', '/contact'], ['Kasba Briefing', '/briefing'], ['Last dates', '/deadlines'], ['Glossary', '/shabdkosh']];
const policies = lang === 'hi'
  ? [['संपादकीय नीति', '/editorial-policy'], ['सुधार नीति', '/corrections'], ['आचार संहिता', '/code-of-ethics'], ['शिकायत निवारण', '/grievance'], ['निजता', '/privacy'], ['नियम व शर्तें', '/terms']]
  : [['Editorial policy', '/editorial-policy'], ['Corrections', '/corrections'], ['Code of ethics', '/code-of-ethics'], ['Grievance redressal', '/grievance'], ['Privacy', '/privacy'], ['Terms', '/terms']];
---
<footer class="site-footer">
  <div class="page grid">
    <div class="brand">
      <div class="logo">कस्बा</div>
      <p>{L.siteNote}</p>
      <p><a class="mail" href="mailto:admin@kasba.co.in">admin@kasba.co.in</a></p>
      <div class="pick"><LocalStrip lang={lang} variant="footer" /></div>
    </div>
    <nav aria-label={L.sections}>
      <h2>{L.sections}</h2>
      <ul>{sectionOrder.map((c) => <li><a href={sectionPath(lang, c)}>{categories[c][lang]}</a></li>)}</ul>
    </nav>
    <nav aria-label={L.aboutKasba}>
      <h2>{L.aboutKasba}</h2>
      <ul>{about.map(([label, href]) => <li><a href={`${p}${href}`}>{label}</a></li>)}</ul>
    </nav>
    <nav aria-label={L.policies}>
      <h2>{L.policies}</h2>
      <ul>{policies.map(([label, href]) => <li><a href={`${p}${href}`}>{label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="page share">
    <span>{lang === 'hi' ? 'कस्बा को आगे भेजें' : 'Share Kasba'}</span>
    <ul aria-label={lang === 'hi' ? 'कस्बा को आगे भेजें' : 'Share Kasba'}>
      {tiles.map((x) => (
        <li><a href={x.href} rel="noopener" target={x.name === 'RSS' ? undefined : '_blank'} aria-label={x.name} title={x.name}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={x.d} /></svg>
        </a></li>
      ))}
    </ul>
  </div>
  <div class="page copy">© {new Date().getFullYear()} Kasba · kasba.co.in</div>
</footer>
<style>
  .site-footer { margin: 4rem var(--gap) var(--gap); background: var(--dark); color: var(--band-text); padding-top: 2.25rem; border-radius: var(--r-card); }
  @media (min-width: 740px) { .site-footer { margin: 4rem 1.6rem 1.6rem; } }
  .page { padding: 0 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .brand { grid-column: 1 / -1; }
  @media (min-width: 900px) { .grid { grid-template-columns: 2fr 1fr 1fr 1fr; } .brand { grid-column: auto; } }
  .logo { font-family: var(--display); font-size: 2.5rem; font-weight: 600; line-height: 1.1; }
  .mail { display: inline-flex; min-height: 44px; align-items: center; }
  p { margin: 0.5rem 0 0; font-size: 0.95rem; color: #c3c3c3; max-width: 28rem; }
  h2 { font-family: var(--display); font-weight: 400; font-size: 1.15rem; margin: 0 0 0.4rem; color: #fff; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: inline-flex; min-height: 40px; align-items: center; font-size: 0.97rem; color: #d6d6d6; }
  li a:hover, p a:hover { text-decoration: underline; color: #fff; }
  .pick { margin-top: 1.25rem; }
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: 2rem; font-size: 0.95rem; color: #c3c3c3; }
  .share ul { display: flex; gap: 0.5rem; }
  .share li a { justify-content: center; width: 44px; min-height: 44px; border-radius: 50%; background: #2a2a2a; color: #e6e6e6; }
  .share li a:hover { background: #3a3a3a; color: #fff; }
  .copy { border-top: 1px solid #333; margin-top: 1.25rem; padding-top: 1rem; padding-bottom: 1.5rem; font-size: 0.85rem; color: #a8a8a8; }
</style>

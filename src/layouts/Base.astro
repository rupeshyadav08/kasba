---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altPath?: string; // the same page in the other language, for hreflang
  jsonLd?: object[];
  type?: 'website' | 'article';
}
const { lang, title, description, altPath, jsonLd = [], type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = altPath ? new URL(altPath, Astro.site) : undefined;
const hiUrl = lang === 'hi' ? canonical : alt;
const enUrl = lang === 'en' ? canonical : alt;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {hiUrl && <link rel="alternate" hreflang="hi" href={hiUrl} />}
  {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
  {hiUrl && <link rel="alternate" hreflang="x-default" href={hiUrl} />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Kasba" />
  <meta name="theme-color" content="#1e6b52" />
  <link rel="alternate" type="application/rss+xml" title="Kasba" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;600;800&family=Noto+Serif+Devanagari:wght@400;600;700&display=swap" />
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
  <Header lang={lang} altPath={altPath} />
  <slot />
  <Footer lang={lang} />
</body>
</html>
